rules_version = '2';
// Paste this whole file into Firebase console → Firestore → Rules → Publish.
// Spark plan. No Cloud Functions. A signed-in member can read and edit a song.
// Anyone else cannot. The invite code is the only way to become a member.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function memberOf(songId) {
      return signedIn() && exists(/databases/$(database)/documents/songs/$(songId)/members/$(request.auth.uid));
    }
    function songOwnerId(songId) {
      return get(/databases/$(database)/documents/songs/$(songId)).data.ownerId;
    }
    function songOwner(songId) {
      return signedIn() && songOwnerId(songId) == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'color'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 40
        && request.resource.data.email is string
        && request.resource.data.email.size() < 80
        && request.resource.data.color is string
        && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$');

      match /songs/{songId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['title', 'key', 'preview', 'updatedAt', 'ownerId', 'color', 'inviteCode'])
          && request.resource.data.title is string
          && request.resource.data.title.size() < 140
          && request.resource.data.ownerId is string
          && request.resource.data.preview is string
          && request.resource.data.preview.size() < 200
          && request.resource.data.updatedAt is number
          && request.resource.data.color is string
          && request.resource.data.inviteCode is string;
      }
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['songId', 'ownerId'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.songId is string
        && songOwner(request.resource.data.songId);
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /songs/{songId} {
      allow get: if signedIn() && (resource.data.ownerId == request.auth.uid || memberOf(songId));
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['title', 'key', 'ownerId', 'inviteCode', 'updatedAt', 'createdAt', 'preview', 'order'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() < 140
        && request.resource.data.key is string
        && request.resource.data.key.size() < 8
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.matches('^[a-z0-9]{8,20}$')
        && request.resource.data.preview is string
        && request.resource.data.order is list
        && request.resource.data.order.size() < 80
        && request.resource.data.updatedAt is number
        && request.resource.data.createdAt is number;
      allow update: if signedIn()
        && (resource.data.ownerId == request.auth.uid || memberOf(songId))
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.inviteCode == resource.data.inviteCode
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'key', 'updatedAt', 'preview', 'order'])
        && request.resource.data.title is string
        && request.resource.data.title.size() < 140
        && request.resource.data.order is list
        && request.resource.data.order.size() < 80;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || memberOf(songId));
        allow list: if memberOf(songId);
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'color', 'email', 'inviteCode'])
          && request.resource.data.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() < 40
          && request.resource.data.color is string
          && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
          && request.resource.data.email is string
          && (
            songOwner(songId)
            || (
              request.resource.data.inviteCode is string
              && exists(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode))
              && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.songId == songId
              && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.ownerId == songOwnerId(songId)
            )
          );
        allow update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.color is string
          && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
          && request.resource.data.name is string
          && request.resource.data.name.size() < 40;
        allow delete: if signedIn() && (request.auth.uid == uid || songOwner(songId));
      }

      match /sections/{secId} {
        allow read: if memberOf(songId);
        allow delete: if memberOf(songId);
        allow create, update: if memberOf(songId)
          && request.resource.data.type is string
          && request.resource.data.type.size() < 60
          && request.resource.data.lines is list
          && request.resource.data.lines.size() < 400;
      }

      match /presence/{uid} {
        allow read: if memberOf(songId);
        allow delete: if memberOf(songId) && request.auth.uid == uid;
        allow create, update: if memberOf(songId)
          && request.auth.uid == uid
          && request.resource.data.name is string
          && request.resource.data.name.size() < 40
          && request.resource.data.color is string
          && request.resource.data.color.matches('^#[0-9a-fA-F]{6}$')
          && request.resource.data.at is number;
      }
    }
  }
}
